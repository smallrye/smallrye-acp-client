<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.smallrye.ai</groupId>
        <artifactId>acp-java-parent</artifactId>
        <version>0.2.3</version>
    </parent>

    <artifactId>acp-java-client</artifactId>
    <description>Java ACP Client - examples</description>
    <name>Smallrye AI :: Agent Client Protocol :: Java Client</name>

    <properties>
        <quarkus.package.jar.type>uber-jar</quarkus.package.jar.type>
    </properties>

    <dependencies>
        <!-- Quarkus Arc (CDI) -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>

        <!-- Aesh CLI framework -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-aesh</artifactId>
        </dependency>

        <!-- Registry module (agent discovery, installation) -->
        <dependency>
            <groupId>io.smallrye.ai</groupId>
            <artifactId>acp-java-registry</artifactId>
            <version>0.2.3</version>
        </dependency>

        <!-- Core module (Acp Client, transport) -->
        <dependency>
            <groupId>io.smallrye.ai</groupId>
            <artifactId>acp-java-core</artifactId>
            <version>0.2.3</version>
        </dependency>

        <!-- Schema module (v1 types used directly in AcpClientCommand) -->
        <dependency>
            <groupId>io.smallrye.ai</groupId>
            <artifactId>acp-java-schema</artifactId>
            <version>0.2.3</version>
        </dependency>

        <!-- TOML support to read the Codex MCP configuration (~/.codex/config.toml) -->
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-toml</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- Filter only the version file to inject the project version and git commit id -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>acp-version.properties</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>acp-version.properties</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <!-- Expose git.commit.id.abbrev used by acp-version.properties (acp version flag) -->
            <plugin>
                <groupId>io.github.git-commit-id</groupId>
                <artifactId>git-commit-id-maven-plugin</artifactId>
                <version>9.0.1</version>
                <executions>
                    <execution>
                        <id>get-git-commit-id</id>
                        <goals>
                            <goal>revision</goal>
                        </goals>
                        <phase>initialize</phase>
                    </execution>
                </executions>
                <configuration>
                    <failOnNoGitDirectory>false</failOnNoGitDirectory>
                    <failOnUnableToExtractRepoInfo>false</failOnUnableToExtractRepoInfo>
                    <generateGitPropertiesFile>false</generateGitPropertiesFile>
                    <abbrevLength>7</abbrevLength>
                    <includeOnlyProperties>
                        <includeOnlyProperty>^git.commit.id.abbrev$</includeOnlyProperty>
                    </includeOnlyProperties>
                </configuration>
            </plugin>
            <plugin>
                <groupId>net.revelc.code</groupId>
                <artifactId>impsort-maven-plugin</artifactId>
                <configuration>
                    <!-- Set the level to 21 to support patterns in switch statements -->
                    <compliance>21</compliance>
                </configuration>
            </plugin>
            <plugin>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.platform.version}</version>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                            <goal>generate-code</goal>
                            <goal>generate-code-tests</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
